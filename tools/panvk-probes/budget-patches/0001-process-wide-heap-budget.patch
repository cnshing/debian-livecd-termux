+struct panvk_heap_account {
+   struct list_head link;
+   dev_t node;
+   unsigned refs;
+   alignas(8) uint64_t used;
+};
+
+static simple_mtx_t heap_accounts_lock = SIMPLE_MTX_INITIALIZER;
+static struct list_head heap_accounts = {&heap_accounts, &heap_accounts};
+
+static VkResult
+panvk_heap_account_init(struct panvk_physical_device *device)
+{
+   struct stat st;
+   if (fstat(device->kmod.dev->fd, &st) != 0)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   simple_mtx_lock(&heap_accounts_lock);
+   list_for_each_entry(struct panvk_heap_account, account, &heap_accounts, link) {
+      if (account->node == st.st_rdev) {
+         account->refs++;
+         device->memory.account = account;
+         simple_mtx_unlock(&heap_accounts_lock);
+         return VK_SUCCESS;
+      }
+   }
+   struct panvk_heap_account *account = calloc(1, sizeof(*account));
+   if (!account) {
+      simple_mtx_unlock(&heap_accounts_lock);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   account->node = st.st_rdev;
+   account->refs = 1;
+   list_addtail(&account->link, &heap_accounts);
+   device->memory.account = account;
+   simple_mtx_unlock(&heap_accounts_lock);
+   return VK_SUCCESS;
+}
+
+static void
+panvk_heap_account_finish(struct panvk_physical_device *device)
+{
+   struct panvk_heap_account *account = device->memory.account;
+   if (!account)
+      return;
+   simple_mtx_lock(&heap_accounts_lock);
+   if (--account->refs == 0) {
+      assert(p_atomic_read(&account->used) == 0);
+      list_del(&account->link);
+      free(account);
+   }
+   device->memory.account = NULL;
+   simple_mtx_unlock(&heap_accounts_lock);
+}
+
+void
+panvk_heap_account_add(struct panvk_physical_device *device, int64_t delta)
+{
+   p_atomic_add(&device->memory.account->used, delta);
+}
