new file mode 100644
index 0000000..09a2873
--- /dev/null
+++ b/src/gallium/frontends/va/picture_vp8.c
@@ -0,0 +1,94 @@
+/*
+ * VP8 decoding through the Termux:VA bridge.
+ * SPDX-License-Identifier: MIT
+ *
+ * A VA-API client parses the uncompressed part of each VP8 frame itself and
+ * submits the rest: the slice data starts at the first (control) partition.
+ * The bridge hands frames to Android's MediaCodec, which needs the complete
+ * frame, so the 3-byte frame tag and, on key frames, the 7-byte start code
+ * and size are rebuilt here (RFC 6386, section 9.1).
+ */
+
+#include "va_private.h"
+
+void
+vlVaHandlePictureParameterBufferVP8(vlVaContext *context, vlVaBuffer *buf)
+{
+   VAPictureParameterBufferVP8 *vp8 = buf->data;
+   struct vlVaVP8PictureDesc *desc = &context->desc.vp8;
+
+   assert(buf->size >= sizeof(VAPictureParameterBufferVP8) && buf->num_elements == 1);
+   desc->width = vp8->frame_width;
+   desc->height = vp8->frame_height;
+   /* VA-API keeps the bitstream's meaning: 0 is a key frame. */
+   desc->key_frame = !vp8->pic_fields.bits.key_frame;
+   desc->version = vp8->pic_fields.bits.version;
+}
+
+void
+vlVaHandleSliceParameterBufferVP8(vlVaContext *context, vlVaBuffer *buf)
+{
+   VASliceParameterBufferVP8 *vp8 = buf->data;
+   struct vlVaVP8PictureDesc *desc = &context->desc.vp8;
+
+   assert(buf->size >= sizeof(VASliceParameterBufferVP8) && buf->num_elements == 1);
+   desc->slice_data_offset = vp8->slice_data_offset;
+   desc->macroblock_offset = vp8->macroblock_offset;
+   desc->num_partitions = MIN2(vp8->num_of_partitions, ARRAY_SIZE(desc->partition_size));
+   for (unsigned i = 0; i < ARRAY_SIZE(desc->partition_size); i++)
+      desc->partition_size[i] = i < desc->num_partitions ? vp8->partition_size[i] : 0;
+}
+
+/* Writes the frame tag (and key-frame header) for this slice data into
+ * desc->header. Returns its length, or 0 if the slice data is inconsistent
+ * with its slice parameters. */
+unsigned
+vlVaDecoderVP8BitstreamHeader(vlVaContext *context, vlVaBuffer *buf)
+{
+   struct vlVaVP8PictureDesc *desc = &context->desc.vp8;
+   unsigned partitions = desc->num_partitions;
+
+   if (partitions < 2 || desc->slice_data_offset > buf->size)
+      return 0;
+
+   /* The slice data holds the first partition, a 3-byte size for every
+    * coefficient partition but the last, then the coefficient partitions.
+    * Clients give the last partition the rest of the buffer, so the first
+    * partition's size follows exactly from the total. partition_size[0] is
+    * only what remains of it after the header the client parsed. */
+   uint64_t rest = 3ull * (partitions - 2);
+   for (unsigned i = 1; i < partitions; i++)
+      rest += desc->partition_size[i];
+   uint64_t total = buf->size - desc->slice_data_offset;
+   if (rest >= total)
+      return 0;
+   uint64_t first = total - rest;
+   if (first < desc->partition_size[0] || first >= (1u << 19))
+      return 0;
+   if (getenv("DMD_VA_LOG"))
+      fprintf(stderr, "tva-vp8: key=%d version=%u %ux%u first=%llu (remaining %u, mb bit %u) partitions=%u\n",
+              desc->key_frame, desc->version, desc->width, desc->height,
+              (unsigned long long)first, desc->partition_size[0],
+              desc->macroblock_offset, partitions);
+
+   /* VA-API has no show_frame: every picture is decoded into its target
+    * surface, so every frame is marked shown and returned by MediaCodec. */
+   uint32_t tag = (desc->key_frame ? 0 : 1) | (desc->version & 7) << 1 | 1 << 4 |
+                  (uint32_t)first << 5;
+   uint8_t *h = desc->header;
+   h[0] = tag;
+   h[1] = tag >> 8;
+   h[2] = tag >> 16;
+   if (!desc->key_frame)
+      return 3;
+   /* Start code, then 14-bit sizes. The scaling bits are lost; they only
+    * suggest how to upscale for display and do not change decoding. */
+   h[3] = 0x9d;
+   h[4] = 0x01;
+   h[5] = 0x2a;
+   h[6] = desc->width;
+   h[7] = (desc->width >> 8) & 0x3f;
+   h[8] = desc->height;
+   h[9] = (desc->height >> 8) & 0x3f;
+   return 10;
+}
