+/* Bit reader over a slice header copied without emulation-prevention bytes. */
+struct tva_br {
+    const uint8_t *d;
+    size_t bits;
+    size_t pos;
+    bool over;
+};
+
+static unsigned
+tva_br_u(struct tva_br *r, unsigned n)
+{
+    unsigned v = 0;
+    for (unsigned i = 0; i < n; i++) {
+        if (r->pos >= r->bits) {
+            r->over = true;
+            return 0;
+        }
+        v = (v << 1) | ((r->d[r->pos >> 3] >> (7 - (r->pos & 7))) & 1);
+        r->pos++;
+    }
+    return v;
+}
+
+static unsigned
+tva_br_ue(struct tva_br *r)
+{
+    unsigned zeros = 0;
+    while (!tva_br_u(r, 1)) {
+        if (r->over || ++zeros > 31) {
+            r->over = true;
+            return 0;
+        }
+    }
+    return zeros ? ((1u << zeros) - 1 + tva_br_u(r, zeros)) : 0;
+}
+
+/* VA-API hands over each slice NAL whole, but not the PPS, so it cannot say
+ * whether a slice relied on num_ref_idx_l{0,1}_default_active_minus1.  Read
+ * num_ref_idx_active_override_flag from the last P or B slice header in the
+ * access unit.  Returns 0 or 1, or -1 when there is no such slice or it
+ * cannot be read.  A 0 means the slice's active counts are the PPS defaults. */
+static int
+tva_h264_slice_override(const uint8_t *data, size_t len,
+                        const struct pipe_h264_pps *pps, bool *is_b)
+{
+    const struct pipe_h264_sps *sps = pps->sps;
+    int result = -1;
+    size_t scan = 0;
+
+    while (scan < len) {
+        size_t sc = tva_next_start_code(data, len, scan);
+        if (sc >= len)
+            break;
+        size_t nal = sc + 3;
+        scan = nal;
+        if (nal >= len)
+            break;
+        unsigned nal_type = data[nal] & 0x1f;
+        if (nal_type != 1 && nal_type != 5)
+            continue;
+
+        /* The header up to the override flag is at most a few dozen bytes. */
+        uint8_t rbsp[64];
+        size_t n = 0, zeros = 0;
+        for (size_t i = nal + 1; i < len && n < sizeof(rbsp); i++) {
+            uint8_t b = data[i];
+            if (zeros >= 2 && b == 3) {
+                zeros = 0;
+                continue;
+            }
+            if (zeros >= 2 && b <= 2)
+                break;
+            rbsp[n++] = b;
+            zeros = b ? 0 : zeros + 1;
+        }
+        struct tva_br r = { rbsp, n * 8, 0, false };
+        tva_br_ue(&r);                                   /* first_mb_in_slice */
+        unsigned slice_type = tva_br_ue(&r) % 5;
+        if (slice_type == 2 || slice_type == 4)          /* I, SI */
+            continue;
+        tva_br_ue(&r);                                   /* pic_parameter_set_id */
+        if (sps->separate_colour_plane_flag)
+            tva_br_u(&r, 2);                             /* colour_plane_id */
+        tva_br_u(&r, sps->log2_max_frame_num_minus4 + 4); /* frame_num */
+        unsigned field_pic = 0;
+        if (!sps->frame_mbs_only_flag) {
+            field_pic = tva_br_u(&r, 1);
+            if (field_pic)
+                tva_br_u(&r, 1);                         /* bottom_field_flag */
+        }
+        if (nal_type == 5)
+            tva_br_ue(&r);                               /* idr_pic_id */
+        if (sps->pic_order_cnt_type == 0) {
+            tva_br_u(&r, sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+            if (pps->bottom_field_pic_order_in_frame_present_flag && !field_pic)
+                tva_br_ue(&r);                           /* delta_pic_order_cnt_bottom */
+        } else if (sps->pic_order_cnt_type == 1 &&
+                   !sps->delta_pic_order_always_zero_flag) {
+            tva_br_ue(&r);                               /* delta_pic_order_cnt[0] */
+            if (pps->bottom_field_pic_order_in_frame_present_flag && !field_pic)
+                tva_br_ue(&r);                           /* delta_pic_order_cnt[1] */
+        }
+        if (pps->redundant_pic_cnt_present_flag)
+            tva_br_ue(&r);                               /* redundant_pic_cnt */
+        if (slice_type == 1)
+            tva_br_u(&r, 1);                             /* direct_spatial_mv_pred */
+        unsigned override = tva_br_u(&r, 1);
+        if (r.over)
+            continue;
+        result = override;
+        *is_b = slice_type == 1;
+    }
+    return result;
+}
