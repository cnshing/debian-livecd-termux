#!/data/data/com.termux/files/usr/bin/bash
# Add optional applications and features to the installed desktop.
#   livecd-pkg list
#   livecd-pkg install NAME...
# NAME is an overlay from overlays/, a short name for one such as mixtapes, or a package
# from this project's repository such as serein. Works while the desktop runs, unless the
# installation would upgrade a library the desktop has loaded.
set -euo pipefail
repo=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)
overlay() {
    case ${1,,} in
        mixtapes|music|music-player) echo 'Music Player';;
        chromium|chrome|google-chrome) echo 'Browser+Chromium';;
        easyeffects|audio-effects) echo 'Audio Effects';;
        gsconnect|phone-sync) echo 'Desktop Environment+Phone Sync';;
        mic|microphone) echo 'Microphone';;
        *) for path in "$repo/overlays"/*/; do
               name=$(basename -- "$path")
               test "${name,,}" != "${1,,}" || { echo "$name"; return; }
           done;;
    esac
}
case ${1:-} in
    list)
        echo 'Features (overlays):'
        for path in "$repo/overlays"/*/; do
            name=$(basename -- "$path")
            grep -qxF -- "- $name" "$repo/overlays/termux.yaml" && continue
            test -e "$path/packages/termux.yaml" -o -e "$path/hooks/termux" -o -e "$path/filesystem/termux" && echo "  $name"
        done
        echo 'Packages from this project not installed yet:'
        for recipe in "$repo"/packages/*/; do
            package=$(basename -- "$recipe")
            dpkg -s "$package" >/dev/null 2>&1 && continue
            printf '  %-22s %s\n' "$package" "$(sed -n 's/^TERMUX_PKG_DESCRIPTION="\(.*\)"$/\1/p' "$recipe/build.sh")"
        done
        echo 'Short names: mixtapes, ungoogled-chromium, easyeffects, gsconnect, microphone'
        ;;
    install)
        shift
        test $# -gt 0 || { echo 'Name what to install: livecd-pkg list' >&2; exit 2; }
        overlays=() packages=() browsers=()
        for name in "$@"; do
            # Not in the default browser set, so only its own installer adds it.
            test "${name,,}" != ungoogled-chromium || { browsers+=(ungoogled-chromium); continue; }
            found=$(overlay "$name")
            if test -n "$found"; then overlays+=("$found"); else packages+=("$name"); fi
        done
        exec 9>>"$HOME/.local/state/livecd/session.lock"
        if ! flock -n 9; then
            # The desktop holds the lock. Adding programs is fine; replacing its libraries is not.
            wanted=("${packages[@]}")
            for name in "${overlays[@]}"; do
                mapfile -t -O "${#wanted[@]}" wanted < <(sed -n 's/^- //p' "$repo/overlays/$name/packages/termux.yaml" 2>/dev/null)
            done
            if test ${#wanted[@]} -gt 0 && apt-get -s install --no-install-recommends "${wanted[@]}" | grep -q '^Inst [^ ]* \['; then
                echo 'This upgrades libraries the desktop is using. Stop it first: livecd stop' >&2
                exit 2
            fi
        fi
        export LIVECD_SETUP_LOCKED=1 DEBIAN_FRONTEND=noninteractive
        test ${#packages[@]} -eq 0 || apt-get install -y --no-install-recommends "${packages[@]}"
        test ${#overlays[@]} -eq 0 || python "$repo/src/apply-overlays.py" "${overlays[@]}"
        test ${#browsers[@]} -eq 0 || bash "$repo/overlays/Browser+Chromium/browsers/install.sh" "${browsers[@]}"
        ;;
    *) sed -n '2,7s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2; exit 2;;
esac
