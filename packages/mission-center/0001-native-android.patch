diff --git a/subprojects/magpie/platform-linux/src/gpus_android.rs b/subprojects/magpie/platform-linux/src/gpus_android.rs
new file mode 100644
index 0000000..56b6289
--- /dev/null
+++ b/subprojects/magpie/platform-linux/src/gpus_android.rs
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Qualcomm KGSL telemetry, read by shell on demand. Missing fields stay None.
+use std::collections::HashMap;
+use magpie_platform::gpus::Gpu;
+pub struct GpuCache(HashMap<String, Gpu>);
+impl magpie_platform::gpus::GpuCache for GpuCache {
+    fn new() -> Self { Self(HashMap::new()) }
+    fn refresh(&mut self) {
+        self.0.clear();
+        let Ok(snapshot) = crate::proc_stat::request("telemetry") else { return };
+        let field = |key: &str| snapshot.lines().find_map(|line| {
+            let (name, value) = line.split_once('\t')?;
+            (name == key).then_some(value.trim())
+        });
+        let Some(model) = field("gpu_model") else { return };
+        let mut gpu = Gpu::default();
+        gpu.id = "kgsl-3d0".into();
+        gpu.device_name = Some(model.into());
+        gpu.temperature_c = crate::proc_stat::thermal(&snapshot, &["gpuss", "gpu"]);
+        if let Some(busy) = field("gpubusy") {
+            let values: Vec<u64> = busy.split_whitespace().filter_map(|s| s.parse().ok()).collect();
+            if values.len() == 2 && values[1] > 0 && values[0] <= values[1] {
+                gpu.utilization_percent = Some(values[0] as f32 / values[1] as f32 * 100.);
+            }
+        }
+        gpu.clock_speed_mhz = field("gpuclk").and_then(|s| s.parse::<u64>().ok()).map(|hz| (hz / 1_000_000) as u32);
+        gpu.max_clock_speed_mhz = field("gpu_available_frequencies")
+            .and_then(|s| s.split_whitespace().filter_map(|v| v.parse::<u64>().ok()).max())
+            .map(|hz| (hz / 1_000_000) as u32);
+        self.0.insert(gpu.id.clone(), gpu);
+    }
+    fn cached_entries(&self) -> &HashMap<String, Gpu> { &self.0 }
+}
