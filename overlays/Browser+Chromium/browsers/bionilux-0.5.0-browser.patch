+// With BIONILUX_LIBRARY_PATH set, the launcher chooses LD_LIBRARY_PATH per target, so
+// that neither it nor a Bionic child ever searches glibc's libraries.
+static int hidden_from_launcher(const char *entry) {
+    if (strncmp(entry, "LD_PRELOAD=", 11) == 0) return 1;
+    return strncmp(entry, "LD_LIBRARY_PATH=", 16) == 0 && getenv("BIONILUX_LIBRARY_PATH");
+}
