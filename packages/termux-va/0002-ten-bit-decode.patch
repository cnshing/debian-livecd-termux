index 0d4a462..0987fc1 100644
--- a/common/tva_protocol.h
+++ b/common/tva_protocol.h
@@ -106,6 +106,15 @@ typedef enum {
     CODEC_H264_BASELINE_ENC = 8,
     CODEC_H264_MAIN_ENC     = 9,
     CODEC_H264_HIGH_ENC     = 10,
+    /* 10-bit sessions (debian-livecd-termux).  Frames travel as P010: a
+     * 16-bit little-endian luma plane, then interleaved 16-bit CbCr, each
+     * sample in the high 10 bits; the format descriptor's stride is in
+     * bytes.  Separate ids, so a daemon or client that predates them rejects
+     * the session instead of reading P010 as NV12.  The daemon lists the
+     * decoders it proved to return real P010 in <socket>.tenbit. */
+    CODEC_HEVC_MAIN10       = 11,   /* decode, P010 out */
+    CODEC_VP9_PROFILE2      = 12,   /* decode, P010 out */
+    CODEC_HEVC_MAIN10_ENC   = 13,   /* encode, P010 in (reserved) */
     CODEC_MAX
 } CodecId;
 
@@ -113,15 +122,23 @@ static inline int codec_is_encoder(int codec)
 {
     return codec == CODEC_H264_ENC || codec == CODEC_HEVC_ENC ||
            codec == CODEC_VP9_ENC || codec == CODEC_H264_BASELINE_ENC ||
-           codec == CODEC_H264_MAIN_ENC || codec == CODEC_H264_HIGH_ENC;
+           codec == CODEC_H264_MAIN_ENC || codec == CODEC_H264_HIGH_ENC ||
+           codec == CODEC_HEVC_MAIN10_ENC;
+}
+
+static inline int codec_is_ten_bit(int codec)
+{
+    return codec == CODEC_HEVC_MAIN10 || codec == CODEC_VP9_PROFILE2 ||
+           codec == CODEC_HEVC_MAIN10_ENC;
 }
 
 static inline int codec_base_id(int codec)
 {
     return (codec == CODEC_H264_ENC || codec == CODEC_H264_BASELINE_ENC ||
             codec == CODEC_H264_MAIN_ENC || codec == CODEC_H264_HIGH_ENC) ? CODEC_H264 :
-           codec == CODEC_HEVC_ENC ? CODEC_HEVC :
-           codec == CODEC_VP9_ENC ? CODEC_VP9 : codec;
+           (codec == CODEC_HEVC_ENC || codec == CODEC_HEVC_MAIN10 ||
+            codec == CODEC_HEVC_MAIN10_ENC) ? CODEC_HEVC :
+           (codec == CODEC_VP9_ENC || codec == CODEC_VP9_PROFILE2) ? CODEC_VP9 : codec;
 }
 
