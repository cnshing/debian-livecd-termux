+/* Write "<mime> <component>" for each decoder proved to return P010 to
+ * <socket>.tenbit.  Replaced atomically; empty when none passed. */
+static void write_ten_bit_list(const char *sock_path)
+{
+    static const struct { const char *mime; const uint8_t *unit; size_t len; } probes[] = {
+        { "video/hevc", probe_hevc_main10, sizeof(probe_hevc_main10) },
+        { "video/x-vnd.on2.vp9", probe_vp9_profile2, sizeof(probe_vp9_profile2) },
+    };
+    char path[600], next[620];
+    snprintf(path, sizeof(path), "%s.tenbit", sock_path);
+    snprintf(next, sizeof(next), "%s.next", path);
+    FILE *f = fopen(next, "we");
+    if (!f) {
+        dlog(0, "cannot write %s: %s", next, strerror(errno));
+        return;
+    }
+    const char *off = getenv("TERMUX_VA_TENBIT");
+    for (size_t i = 0; !(off && !strcmp(off, "0")) && i < sizeof(probes) / sizeof(probes[0]); i++) {
+        char component[128] = "";
+        if (probe_ten_bit_decoder(probes[i].mime, probes[i].unit, probes[i].len,
+                                  component, sizeof(component)))
+            fprintf(f, "%s %s\n", probes[i].mime, component);
+    }
+    if (fclose(f) != 0 || rename(next, path) != 0)
+        dlog(0, "cannot publish %s: %s", path, strerror(errno));
+}
