     #include <unistd.h>
 #endif /* PLATFORM_WINDOWS */
 
+#ifdef __ANDROID__
+#include <string>
+#include <cstdlib>
+#include <cstring>
+// Bionic has mmap but no POSIX shm_open. Keep named segments in the app's
+// private temporary directory, with ordinary O_CREAT/O_EXCL and unlink semantics.
+static std::string android_shm_path(const char *name)
+{
+    if (name == NULL || name[0] != '/' || name[1] == 0 || strchr(name + 1, '/') != NULL)
+    {
+        errno = EINVAL;
+        return {};
+    }
+    const char *tmp = getenv("TMPDIR");
+    if (tmp == NULL || tmp[0] == 0)
+        tmp = "@TERMUX_PREFIX@/tmp";
+    return std::string(tmp) + "/lsp-shm-" + (name + 1);
+}
+static int shm_open(const char *name, int flags, mode_t mode)
+{
+    auto path = android_shm_path(name);
+    return path.empty() ? -1 : open(path.c_str(), flags | O_CLOEXEC | O_NOFOLLOW, mode & 0600);
+}
+static int shm_unlink(const char *name)
+{
+    auto path = android_shm_path(name);
+    return path.empty() ? -1 : unlink(path.c_str());
+}
+#endif
+
