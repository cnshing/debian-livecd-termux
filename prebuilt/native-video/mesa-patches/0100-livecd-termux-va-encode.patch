 static void
+tva_encode_set_crop(struct tva_codec *c, unsigned left, unsigned right,
+                    unsigned top, unsigned bottom)
+{
+    unsigned x = 2 * left, y = 2 * top;
+    unsigned w = 2 * (left + right), h = 2 * (top + bottom);
+    if (!w && !h)
+        return;
+    if (w >= c->base.width || h >= c->base.height)
+        return;
+    c->encode_x = x;
+    c->encode_y = y;
+    c->encode_width = c->base.width - w;
+    c->encode_height = c->base.height - h;
