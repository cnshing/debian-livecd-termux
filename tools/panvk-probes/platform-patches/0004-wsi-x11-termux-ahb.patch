+#if defined(VK_USE_PLATFORM_ANDROID_KHR) && defined(HAVE_X11_DRM)
+static VkResult
+x11_image_import_ahb(struct x11_swapchain *chain, struct x11_image *image,
+                     const VkSwapchainCreateInfoKHR *create)
+{
+   int sockets[2];
+   if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   const struct timeval timeout = { .tv_sec = 3 };
+   if (setsockopt(sockets[0], SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+       setsockopt(sockets[0], SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))) {
+      close(sockets[0]);
+      close(sockets[1]);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   xcb_void_cookie_t cookie = xcb_dri3_pixmap_from_buffers_checked(
+      chain->conn, image->pixmap, chain->window, 1,
+      create->imageExtent.width, create->imageExtent.height,
+      image->base.row_pitches[0], 0, 0, 0, 0, 0, 0, 0,
+      chain->depth, 32, 1255, &sockets[1]);
+   xcb_flush(chain->conn);
+   uint8_t request = 0;
+   ssize_t received;
+   do {
+      received = read(sockets[0], &request, 1);
+   } while (received < 0 && errno == EINTR);
+   int sent = received == 1 && request == 1 ?
+      AHardwareBuffer_sendHandleToUnixSocket(image->base.ahb, sockets[0]) : -1;
+   close(sockets[0]);
+   if (sent != 0)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   xcb_generic_error_t *error = xcb_request_check(chain->conn, cookie);
+   if (error) {
+      free(error);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   return VK_SUCCESS;
+}
