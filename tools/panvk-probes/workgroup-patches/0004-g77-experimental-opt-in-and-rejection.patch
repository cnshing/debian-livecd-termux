diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index e4bebf3..91d2af1 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -1037,10 +1037,14 @@ panvk_per_arch(get_physical_device_properties)(
        * As such we limit to the max threads per workgroup supported by the GPU.
        */
       .maxComputeWorkGroupInvocations =
-         device->kmod.dev->props.max_threads_per_wg,
-      .maxComputeWorkGroupSize = {device->kmod.dev->props.max_threads_per_wg,
-                                  device->kmod.dev->props.max_threads_per_wg,
-                                  device->kmod.dev->props.max_threads_per_wg},
+         (PAN_ARCH == 9 && debug_get_bool_option("PANVK_G77_LWG", false)
+             ? 1024 : device->kmod.dev->props.max_threads_per_wg),
+      .maxComputeWorkGroupSize = {(PAN_ARCH == 9 && debug_get_bool_option("PANVK_G77_LWG", false)
+             ? 1024 : device->kmod.dev->props.max_threads_per_wg),
+                                  (PAN_ARCH == 9 && debug_get_bool_option("PANVK_G77_LWG", false)
+             ? 1024 : device->kmod.dev->props.max_threads_per_wg),
+                                  (PAN_ARCH == 9 && debug_get_bool_option("PANVK_G77_LWG", false)
+             ? 1024 : device->kmod.dev->props.max_threads_per_wg)},
       /* 8-bit subpixel precision. */
       .subPixelPrecisionBits = 8,
       .subTexelPrecisionBits = 8,
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index ca77854..42d98be 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -842,6 +842,8 @@ panvk_lower_large_workgroup(nir_shader *nir, unsigned max_hw)
       return false;
    }
    const unsigned h = n / k;
+   if (h % pan_subgroup_size(PAN_ARCH))
+      return false;
 
    nir_function_impl *impl = nir_shader_get_entrypoint(nir);
    nir_lower_returns_impl(impl);
@@ -962,9 +964,10 @@ panvk_preprocess_nir(struct vk_physical_device *vk_pdev,
 {
    struct panvk_physical_device *pdev = to_panvk_physical_device(vk_pdev);
 
-#if PAN_ARCH < 9
-   /* Half the limit: a shader over 32 registers halves the threads per core. */
-   if (nir->info.stage == MESA_SHADER_COMPUTE)
+#if PAN_ARCH == 9
+   /* Private G77 experiment; ordinary operation preserves release behavior. */
+   if (nir->info.stage == MESA_SHADER_COMPUTE &&
+       debug_get_bool_option("PANVK_G77_LWG", false))
       NIR_PASS(_, nir, panvk_lower_large_workgroup,
                pdev->kmod.dev->props.max_threads_per_wg / 2);
 #endif
@@ -4935,6 +4938,21 @@ panvk_compile_shader(struct panvk_device *dev,
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(dev->vk.physical);
 
+#if PAN_ARCH == 9
+   /* Preprocessing leaves unsupported control flow unchanged. Never submit
+    * an oversized shader that the experimental pass failed to lower. */
+   if (info->stage == MESA_SHADER_COMPUTE &&
+       debug_get_bool_option("PANVK_G77_LWG", false)) {
+      const unsigned n = info->nir->info.workgroup_size[0] *
+                         info->nir->info.workgroup_size[1] *
+                         info->nir->info.workgroup_size[2];
+      if (n > phys_dev->kmod.dev->props.max_threads_per_wg / 2) {
+         mesa_loge("panvk: experimental G77 workgroup lowering rejected %u invocations", n);
+         return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+      }
+   }
+#endif
+
    struct panvk_shader *shader;
    VkResult result;
 
