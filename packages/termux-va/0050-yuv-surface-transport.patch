+/* fd refers to linear NV12. Non-matching gralloc geometry is rejected, not
+ * reinterpreted. The caller can upload an inline frame to a fresh buffer. */
+static int yuv_buffer_import(YuvBuffer *b, int fd, const uint32_t m[8])
+{
+ if (m[0] != 0x3231564e || m[1] > 8192 || m[2] > 4320 ||
+     yuv_buffer_new(b, m[1], m[2])) return -1;
+ off_t actual = lseek(fd, 0, SEEK_END);
+ if (m[3] != b->stride || m[4] != b->uv_offset || m[5] < b->size ||
+     actual < 0 || (uint64_t)actual < m[5] || m[5] > MAX_ENCODE_FRAME) goto fail;
+ const YuvNativeHandle *h = z.handle(b->buffer);
+ if (!h || h->numFds != 2 || h->numInts <= 0 || h->numInts > 128) goto fail;
+ size_t bytes = sizeof(*h) + sizeof(int) * (h->numFds + h->numInts);
+ YuvNativeHandle *copy = malloc(bytes);
+ if (!copy) goto fail;
+ memcpy(copy, h, bytes); copy->data[0] = fd;
+ AHardwareBuffer *imported = NULL;
+ int result = z.wrap(&b->desc, copy, 3 /* CLONE */, &imported);
+ free(copy);
+ if (result || !imported) goto fail;
+ z.AHardwareBuffer_release(b->buffer); b->buffer = imported;
+ return 0;
+fail:
+ yuv_buffer_close(b);
+ return -1;
+}
