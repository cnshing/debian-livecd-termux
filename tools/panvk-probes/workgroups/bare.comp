#version 450
#ifndef X
#define X 512
#define Y 1
#define Z 1
#endif
#define N (X * Y * Z)
layout(local_size_x = X, local_size_y = Y, local_size_z = Z) in;
layout(std430, binding = 0) buffer Out { uvec4 data[]; };
void main() {
   uint i = gl_LocalInvocationIndex;
   uint g = gl_WorkGroupID.x + 3u * gl_WorkGroupID.y;
   uint mine = i * 3u + g * 17u + 1u;
   uint neighbour = (N - 1u - i) * 3u + g * 17u + 1u;
   uint o = (g * N + i) * 4u;
   data[o] = uvec4(i, gl_LocalInvocationID);
   data[o + 1u] = uvec4(gl_GlobalInvocationID, gl_WorkGroupSize.x);
   data[o + 2u] = uvec4(gl_WorkGroupSize.yz, g, neighbour);
   data[o + 3u] = uvec4(N * (N - 1u) / 2u, mine, 15u, mine ^ neighbour);
}
