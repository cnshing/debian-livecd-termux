+/* Source/destination remain alive through glFinish. Decoder buffers are
+ * exported only after it completes, and encoder source ownership is retained
+ * until the corresponding encoded packet reaches the client. */
+static int yuv_draw(YuvContext *c, AHardwareBuffer *source,
+                    AHardwareBuffer *destination, unsigned w, unsigned h,
+                    float x, float y, float rw, float rh, int swap_uv,
+                    int64_t pts_ns)
+{
+ EGLint attrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+ EGLImageKHR images[2] = {EGL_NO_IMAGE_KHR, EGL_NO_IMAGE_KHR};
+ GLuint textures[2] = {0}, fb = 0;
+ int result = -1;
+ while (z.glGetError() != GL_NO_ERROR) {}
+ images[0] = z.create_image(z.display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                           z.native(source), attrs);
+ if (images[0] == EGL_NO_IMAGE_KHR) goto out;
+ z.glGenTextures(2, textures);
+ z.glBindTexture(GL_TEXTURE_EXTERNAL_OES, textures[0]);
+ z.bind_image(GL_TEXTURE_EXTERNAL_OES, images[0]);
+ z.glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+ z.glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+ z.glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+ z.glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+ if (destination) {
+  images[1] = z.create_image(z.display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                            z.native(destination), attrs);
+  if (images[1] == EGL_NO_IMAGE_KHR) goto out;
+  z.glBindTexture(GL_TEXTURE_2D, textures[1]); z.bind_image(GL_TEXTURE_2D, images[1]);
+  z.glGenFramebuffers(1, &fb); z.glBindFramebuffer(GL_FRAMEBUFFER, fb);
+  z.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[1], 0);
+  if (z.glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) goto out;
+ } else z.glBindFramebuffer(GL_FRAMEBUFFER, 0);
+ z.glUseProgram(c->program);
+ z.glUniform4f(z.glGetUniformLocation(c->program, "rect"), x, y, rw, rh);
+ z.glUniform4f(z.glGetUniformLocation(c->program, "order"), swap_uv, 0, 0, 0);
+ const GLfloat vertices[] = {-1,-1,1,-1,-1,1,1,1};
+ z.glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, vertices);
+ z.glEnableVertexAttribArray(0); z.glViewport(0, 0, w, h);
+ z.glBindTexture(GL_TEXTURE_EXTERNAL_OES, textures[0]);
+ z.glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+ if (z.glGetError() != GL_NO_ERROR) goto out;
+ if (!destination && (!z.presentation_time(z.display, c->surface, pts_ns) ||
+                      !z.eglSwapBuffers(z.display, c->surface))) goto out;
+ z.glFinish();
+ if (z.glGetError() == GL_NO_ERROR) result = 0;
+out:
+ /* Also finish failed submissions before releasing imported memory. */
+ z.glFinish();
+ if (fb) z.glDeleteFramebuffers(1, &fb);
+ z.glDeleteTextures(2, textures);
+ for (int i=0; i<2; i++) if (images[i] != EGL_NO_IMAGE_KHR)
+  z.destroy_image(z.display, images[i]);
+ return result;
+}
