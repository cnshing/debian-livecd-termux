+#if defined(__linux__)
+/* Reads rows of a linear, CPU-written surface through its dma-buf.  A Gallium
+ * map of a KGSL buffer is uncached, and reading a 4K picture through it takes
+ * tens of milliseconds; the dma-buf mapping of the same ION/heap memory is
+ * cached, with DMA_BUF_IOCTL_SYNC keeping the CPU view coherent. */
+static bool
+tva_direct_read_plane(struct pipe_screen *screen, struct pipe_resource *res,
+                      unsigned x, unsigned y0, unsigned row_bytes,
+                      unsigned rows, uint8_t *dst)
+{
+    if (!screen || !screen->resource_get_handle || !res || !row_bytes || !rows)
+        return false;
+    struct winsys_handle whandle;
+    memset(&whandle, 0, sizeof(whandle));
+    whandle.type = WINSYS_HANDLE_TYPE_FD;
+    if (!screen->resource_get_handle(screen, NULL, res, &whandle, 0))
+        return false;
+    const int fd = whandle.handle;
+    const uint64_t stride = whandle.stride, size = whandle.size;
+    const uint64_t first = whandle.offset + (uint64_t)y0 * stride + x;
+    const uint64_t need = (uint64_t)(rows - 1) * stride + row_bytes;
+    /* Only a linear layout can be read as rows. */
+    if (fd < 0 || whandle.modifier != DRM_FORMAT_MOD_LINEAR ||
+        !stride || stride < (uint64_t)x + row_bytes || !size ||
+        first > size || need > size - first) {
+        if (fd >= 0)
+            close(fd);
+        return false;
+    }
+    const uint64_t map_offset = first & ~(uint64_t)4095;
+    const size_t map_len = (size_t)(first - map_offset + need);
+    uint8_t *map = mmap(NULL, map_len, PROT_READ, MAP_SHARED, fd, (off_t)map_offset);
+    if (map == MAP_FAILED) {
+        close(fd);
+        return false;
+    }
+    struct dma_buf_sync sync = { .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ };
+    const bool synced = ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) == 0;
+    const uint8_t *src = map + (first - map_offset);
+    if (stride == row_bytes)
+        memcpy(dst, src, (size_t)row_bytes * rows);
+    else
+        for (unsigned y = 0; y < rows; y++)
+            memcpy(dst + (size_t)y * row_bytes, src + (size_t)y * stride, row_bytes);
+    if (synced) {
+        sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+        ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    }
+    munmap(map, map_len);
+    close(fd);
+    return true;
+}
+#endif
