+int
+kbase_kmod_jm_export_fence(struct pan_kmod_dev *dev, uint64_t dep0,
+                           uint64_t dep1)
+{
+   struct { int fd; int stream_fd; } fence = {-1, -1};
+   uint64_t atom = kbase_kmod_job_submit_dep(dev, (uintptr_t)&fence,
+      0x202, NULL, 0, dep0, 1, dep1, 1, true);
+   if (!atom || fence.fd < 0) {
+      if (fence.fd >= 0)
+         close(fence.fd);
+      return -1;
+   }
+   return fence.fd;
+}
