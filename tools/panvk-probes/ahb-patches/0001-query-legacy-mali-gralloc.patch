 static int
+panvk_mali_query_metadata(const native_handle_t *raw,
+                          struct u_gralloc_buffer_basic_info *out)
+{
+   uint64_t format = 0;
+   int64_t offset = -1;
+   int fd = -1, stride = 0, allocation = 0, width = 0, height = 0;
+   uint32_t layers = 0;
+   if (raw->numFds < 1 || raw->numFds > 5 ||
+       panvk_mali_metadata.format(NULL, raw, &format) ||
+       panvk_mali_metadata.fd(NULL, raw, &fd) ||
+       panvk_mali_metadata.dimensions(NULL, raw, &width, &height) ||
+       panvk_mali_metadata.offset(NULL, raw, &offset) ||
+       panvk_mali_metadata.stride(NULL, raw, &stride) ||
+       panvk_mali_metadata.size(NULL, raw, &allocation) ||
+       panvk_mali_metadata.layers(raw, &layers))
+      return -EINVAL;
+
+   if (format != HAL_PIXEL_FORMAT_RGBA_8888 &&
+       format != HAL_PIXEL_FORMAT_RGBX_8888 &&
+       format != HAL_PIXEL_FORMAT_BGRA_8888)
+      return -ENOTSUP;
+
+   bool fd_present = false;
+   for (int i = 0; i < raw->numFds; i++)
+      fd_present |= raw->data[i] == fd;
+   if (!fd_present || fd < 0 || layers != 1 || width <= 0 || height <= 0 ||
+       stride <= 0 || (uint64_t)stride < (uint64_t)width * 4 ||
+       offset < 0 || offset > INT_MAX || allocation <= 0)
+      return -EINVAL;
+
+   off_t fd_size = lseek(fd, 0, SEEK_END);
+   uint64_t end = (uint64_t)offset + (uint64_t)stride * height;
+   if (fd_size <= 0 || end > (uint64_t)allocation ||
+       (uint64_t)allocation > (uint64_t)fd_size)
+      return -EINVAL;
+
+   int fourcc = get_fourcc_from_hal_format((int)format);
+   if (fourcc == -1)
+      return -EINVAL;
+   out->drm_fourcc = fourcc;
+   out->modifier = DRM_FORMAT_MOD_LINEAR;
+   out->num_planes = 1;
+   out->fds[0] = fd;
+   out->strides[0] = stride;
+   out->offsets[0] = (int)offset;
+   return 0;
+}
+
+static int
 panvk_v19_query_mapper(const native_handle_t *raw, struct u_gralloc_buffer_basic_info *out)
 {
    if (!raw || !out || panvk_v19_init_mapper()) return -ENOTSUP;
+   if (panvk_v19_backend == 1)
+      return panvk_mali_query_metadata(raw, out);
    panvk_v19_buffer_handle_t imported = NULL;
    int32_t ir = panvk_v19_import(raw, &imported);
    if (ir || !imported) {
