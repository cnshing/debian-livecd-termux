   current_sps_.vui_parameters_present_flag = true;
+  // Signal the samples' range and color space; a decoder otherwise assumes
+  // limited range, and full range input (canvas capture) decodes too dark
+  // and saturated. A VA driver that writes its own parameter sets learns
+  // them from this packed SPS.
+  const bool yuv_range =
+      color_space_.range() == gfx::ColorSpace::RangeID::FULL ||
+      color_space_.range() == gfx::ColorSpace::RangeID::LIMITED;
+  current_sps_.video_signal_type_present_flag =
+      yuv_range && color_space_.matrix() != VideoColorSpace::MatrixID::RGB &&
+      color_space_.matrix() != VideoColorSpace::MatrixID::INVALID;
+  if (current_sps_.video_signal_type_present_flag) {
+    current_sps_.video_format = 5;  // Unspecified video format.
+    current_sps_.video_full_range_flag =
+        color_space_.range() == gfx::ColorSpace::RangeID::FULL;
+    current_sps_.colour_description_present_flag = true;
+    auto code = [](auto id) {
+      const int value = static_cast<int>(id);
+      return value == 0 || value == 255 ? 2 : value;  // INVALID: unspecified.
+    };
+    current_sps_.colour_primaries = code(color_space_.primaries());
+    current_sps_.transfer_characteristics = code(color_space_.transfer());
+    current_sps_.matrix_coefficients = code(color_space_.matrix());
+  } else {
+    current_sps_.colour_description_present_flag = false;
+  }
   current_sps_.timing_info_present_flag = true;
   current_sps_.num_units_in_tick = 1;
   current_sps_.time_scale =
@@ -877,6 +905,21 @@
