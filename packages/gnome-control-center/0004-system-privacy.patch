 G_DEFINE_TYPE (CcSecureShellPage, cc_secure_shell_page, ADW_TYPE_DIALOG)
 
+/* Termux's OpenSSH listens on port 8022 unless sshd_config says otherwise. */
+static gchar *
+get_sshd_port (void)
+{
+  g_autofree gchar *contents = NULL;
+  g_auto(GStrv) lines = NULL;
+
+  if (g_file_get_contents (SSHD_CONFIG, &contents, NULL, NULL))
+    {
+      lines = g_strsplit (contents, "\n", -1);
+      for (gsize i = 0; lines[i] != NULL; i++)
+        {
+          g_auto(GStrv) words = g_strsplit_set (g_strstrip (lines[i]), " \t=", -1);
+
+          if (words[0] != NULL && g_ascii_strcasecmp (words[0], "Port") == 0)
+            for (gsize j = 1; words[j] != NULL; j++)
+              if (*words[j] != '\0')
+                return g_strdup (words[j]);
+        }
+    }
+
+  return g_strdup ("8022");
+}
+
+/* The phone has no LAN hostname: prefer the Wi-Fi address, then any other
+ * local IPv4 address. Cellular interfaces are not reachable from the LAN. */
+static gchar *
+get_lan_address (void)
+{
+  struct ifaddrs *addresses, *address;
+  g_autofree gchar *fallback = NULL;
+  gchar text[INET_ADDRSTRLEN];
+
+  if (getifaddrs (&addresses) != 0)
+    return g_strdup ("localhost");
+
+  for (address = addresses; address != NULL; address = address->ifa_next)
+    {
+      if (address->ifa_addr == NULL || address->ifa_addr->sa_family != AF_INET ||
+          !(address->ifa_flags & IFF_UP) || (address->ifa_flags & IFF_LOOPBACK) ||
+          g_str_has_prefix (address->ifa_name, "rmnet") ||
+          inet_ntop (AF_INET, &((struct sockaddr_in *) address->ifa_addr)->sin_addr,
+                     text, sizeof (text)) == NULL)
+        continue;
+
+      if (g_str_has_prefix (address->ifa_name, "wlan"))
+        {
+          freeifaddrs (addresses);
+          return g_strdup (text);
+        }
+      if (fallback == NULL)
+        fallback = g_strdup (text);
+    }
+
+  freeifaddrs (addresses);
+  return fallback ? g_steal_pointer (&fallback) : g_strdup ("localhost");
+}
+
