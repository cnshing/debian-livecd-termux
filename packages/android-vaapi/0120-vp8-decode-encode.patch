+/* <socket>.decoders: hardware decoders for the codecs the bridge offers
+ * only when present (VP8). Missing means a daemon that predates it. */
+static void tva_read_decoders(void)
+{
+    char endpoint[512], path[600];
+    snprintf(path, sizeof(path), "%s.decoders",
+             tva_default_endpoint(endpoint, sizeof(endpoint)));
+    FILE *f = fopen(path, "re");
+    if (!f)
+        return;
+    size_t n = fread(tva_decoders, 1, sizeof(tva_decoders) - 1, f);
+    tva_decoders[n] = '\0';
+    fclose(f);
+}
+
+bool tva_decoder_listed(const char *mime)
+{
+    static util_once_flag once = UTIL_ONCE_FLAG_INIT;
+    util_call_once(&once, tva_read_decoders);
+    return tva_list_has(tva_decoders, mime);
