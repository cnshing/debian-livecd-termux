+static char tva_ten_bit[1024];
+
+static void tva_read_ten_bit(void)
+{
+    char endpoint[512], path[600];
+    snprintf(path, sizeof(path), "%s.tenbit",
+             tva_default_endpoint(endpoint, sizeof(endpoint)));
+    FILE *f = fopen(path, "re");
+    if (!f)
+        return;   /* an older daemon: no 10-bit sessions */
+    size_t n = fread(tva_ten_bit, 1, sizeof(tva_ten_bit) - 1, f);
+    tva_ten_bit[n] = '\0';
+    fclose(f);
+}
+
+bool tva_ten_bit_available(const char *mime)
+{
+    static util_once_flag once = UTIL_ONCE_FLAG_INIT;
+    util_call_once(&once, tva_read_ten_bit);
+    size_t len = strlen(mime);
+    for (const char *line = tva_ten_bit; *line;
+         line = strchr(line, '\n') ? strchr(line, '\n') + 1 : "") {
+        if (!strncmp(line, mime, len) && line[len] == ' ')
+            return true;
+    }
+    return false;
+}
