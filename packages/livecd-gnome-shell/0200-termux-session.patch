+// SPDX-License-Identifier: GPL-2.0-or-later
+// Android owns authentication; this X11 desktop cannot act as a login manager.
+export const UserVerifierChoiceList = {
+    interface_info() {
+        return {name: 'org.gnome.DisplayManager.UserVerifierChoiceList'};
+    },
+};
+export class Client {
+    constructor() {
+        throw new Error('GDM authentication is unavailable in Termux');
+    }
+}
+export function get_session_ids() { return []; }
+export function get_session_name_and_description() { return ['', '']; }
+export function goto_login_session_sync() { return false; }
--- /dev/null
+++ b/js/misc/termux/polkit.js
@@ -0,0 +1,69 @@
+/*
+ * GNOME Shell Polkit compatibility layer for Termux.
+ *
+ * Termux does not provide the normal Polkit/PolkitAgent stack.
+ * GNOME Shell therefore gets local objects that never grant authorization.
+ */
+
+export class Permission {
+    constructor() {
+        this.allowed = false;
+        this.canAcquire = false;
+        this.challenge = false;
+    }
+
+    static new(_actionId, _subject = null, _cancellable = null, callback = null) {
+        if (callback)
+            callback(null, {});
+        return Promise.resolve(new Permission());
+    }
+
+    static new_finish(_result) {
+        return new Permission();
+    }
+
+    static new_sync(_actionId, _subject = null, _cancellable = null) {
+        return new Permission();
+    }
+
+    get_allowed() {
+        return false;
+    }
+
+    get_can_acquire() {
+        return false;
+    }
+
+    get_can_acquire_via_agent() {
+        return false;
+    }
+
+    get_is_challenge() {
+        return false;
+    }
+}
+
+export class UnixUser {
+    constructor(name) {
+        this.name = name;
+    }
+
+    static new_for_name(name) {
+        return new UnixUser(name);
+    }
+}
+
+export class Subject {
+    constructor() {
+    }
+
+    static new_for_process_sync() {
+        return new Subject();
+    }
+}
+
+export default {
+    Permission,
+    UnixUser,
+    Subject,
+};
