+static PROCESS_COUNT: AtomicU64 = AtomicU64::new(0);
+static THREAD_COUNT: AtomicU64 = AtomicU64::new(0);
+pub fn counts() -> (u64, u64) {
+    (PROCESS_COUNT.load(Ordering::Relaxed), THREAD_COUNT.load(Ordering::Relaxed))
+}
+
+pub struct ProcessCache {
+    entries: HashMap<u32, Process>,
+    ticks: HashMap<u32, (u64, u64)>, // start time prevents PID-reuse spikes
+    timestamp: Instant,
+    network_error: Option<NetworkStatsError>,
+}
+
+fn state(value: &str) -> ProcessState {
+    match value {
+        "R" => ProcessState::Running, "S" => ProcessState::Sleeping,
+        "D" => ProcessState::SleepingUninterruptible, "Z" => ProcessState::Zombie,
+        "T" => ProcessState::Stopped, "t" => ProcessState::Tracing,
+        "X" | "x" => ProcessState::Dead, "K" => ProcessState::WakeKill,
+        "W" => ProcessState::Waking, "P" => ProcessState::Parked,
+        _ => ProcessState::Unknown,
+    }
+}
+
+impl magpie_platform::processes::ProcessCache for ProcessCache {
+    fn new() -> Self {
+        Self { entries: HashMap::new(), ticks: HashMap::new(), timestamp: Instant::now(), network_error: Some(NetworkStatsError::PermissionsError(Default::default())) }
+    }
+    fn refresh(&mut self) {
+        let snapshot = match crate::proc_stat::request("processes") {
+            Ok(snapshot) => snapshot,
+            Err(e) => {
+                log::error!("Android process snapshot unavailable: {e}");
+                self.entries.clear(); self.ticks.clear();
+                PROCESS_COUNT.store(0, Ordering::Relaxed); THREAD_COUNT.store(0, Ordering::Relaxed);
+                return;
+            }
+        };
+        let now = Instant::now();
+        let elapsed = now.duration_since(self.timestamp).as_secs_f64();
+        let old_ticks = std::mem::take(&mut self.ticks);
+        let mut entries = HashMap::new();
+        let hz = crate::util::sys_hz() as f64;
+        let page_size = crate::util::sys_page_size() as u64;
+        for line in snapshot.lines() {
+            let fields: Vec<_> = line.split('\t').collect();
+            if fields.len() != 6 || fields[0] != "P" { continue; }
+            let Ok(pid) = fields[1].parse::<u32>() else { continue };
+            let Ok(stat) = crate::proc_stat::unhex(fields[3]) else { continue };
+            let (Some(first), Some(last)) = (stat.find('('), stat.rfind(')')) else { continue };
+            if last <= first { continue; }
+            let values: Vec<_> = stat[last + 1..].split_whitespace().collect();
+            if values.len() < 22 { continue; }
+            let parse = |i: usize| values[i].parse::<u64>().unwrap_or(0);
+            let start = parse(19);
+            let ticks = parse(11).saturating_add(parse(12));
+            let cpu = old_ticks.get(&pid).filter(|(old_start, _)| *old_start == start)
+                .map(|(_, previous)| ticks.saturating_sub(*previous) as f64 / hz / elapsed * 100.)
+                .filter(|value| value.is_finite()).unwrap_or(0.) as f32;
+            self.ticks.insert(pid, (start, ticks));
+            let cmd = crate::proc_stat::unhex(fields[4]).unwrap_or_default()
+                .split('\0').filter(|part| !part.is_empty()).map(str::to_owned).collect();
+            let exe = crate::proc_stat::unhex(fields[5]).unwrap_or_default();
+            let mut usage = ProcessUsageStats::default();
+            usage.cpu_usage = cpu;
+            usage.memory_usage = parse(21).saturating_mul(page_size); // RSS, not PSS
+            entries.insert(pid, Process {
+                name: stat[first + 1..last].to_owned(), cmd, exe,
+                state: state(values[0]) as i32, pid, parent: parse(1) as u32,
+                usage_stats: usage, task_count: parse(17), children: Vec::new(),
+            });
+        }
+        // Build all trees, including Android parents that native Termux cannot see.
+        let parents: Vec<_> = entries.values().map(|p| (p.pid, p.parent)).collect();
+        for (pid, parent) in parents {
+            if pid == parent { continue; }
+            if let Some(p) = entries.get_mut(&parent) { p.children.push(pid); }
+        }
+        PROCESS_COUNT.store(entries.len() as u64, Ordering::Relaxed);
+        THREAD_COUNT.store(entries.values().map(|p| p.task_count).sum(), Ordering::Relaxed);
+        self.entries = entries;
+        self.timestamp = now;
+    }
+    fn cached_entries(&self) -> &HashMap<u32, Process> { &self.entries }
+    fn cached_network_stats_error(&self) -> &Option<NetworkStatsError> { &self.network_error }
+}
