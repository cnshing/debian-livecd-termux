+/* Smallest even buffer of at least 96x96 that holds a visible picture.
+ * Returns -1 above the 8192x4320 protocol limit. */
+static int tva_padded_frame_size(unsigned width, unsigned height,
+                                 unsigned *buffer_w, unsigned *buffer_h)
+{
+ if (!width || !height || width > 8192 || height > 4320) return -1;
+ unsigned w = (width + 1u) & ~1u, h = (height + 1u) & ~1u;
+ *buffer_w = w < 96 ? 96 : w;
+ *buffer_h = h < 96 ? 96 : h;
+ return 0;
+}
