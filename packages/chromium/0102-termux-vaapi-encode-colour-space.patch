 }
 
+bool H264VaapiVideoEncoderDelegate::SetColorSpace(
+    const gfx::ColorSpace& color_space) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const VideoColorSpace video_color_space =
+      VideoColorSpace::FromGfxColorSpace(color_space);
+  if (video_color_space == color_space_) {
+    return false;
+  }
+  color_space_ = video_color_space;
+  // Sets |encoding_parameters_changed_|, so the next frame is an IDR with
+  // the new SPS.
+  UpdateSPS();
+  return true;
+}
