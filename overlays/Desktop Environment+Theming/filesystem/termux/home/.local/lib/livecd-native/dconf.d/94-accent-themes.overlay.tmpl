# Upstream's 01-theming.overlay.tmpl accent sections, rendered with its configuration (scheme
# nord, opacity solid), since overlays here are not Jinja templates. Two adaptations: Colloid's
# own installer, which colloid-icon-theme uses, capitalizes its variants (Colloid-Yellow-Dark, not
# the live CD PPA's Colloid-yellow-dark), and the variants are built in the desktop's data directory.

[org/gnome/shell/extensions/accent-icons-theme]
change-app-colors=true
blue-theme-light='Colloid-Light'
blue-theme-dark='Colloid-Dark'
teal-theme-light='Colloid-Teal-Light'
teal-theme-dark='Colloid-Teal-Dark'
green-theme-light='Colloid-Green-Light'
green-theme-dark='Colloid-Green-Dark'
yellow-theme-light='Colloid-Yellow-Light'
yellow-theme-dark='Colloid-Yellow-Dark'
orange-theme-light='Colloid-Orange-Light'
orange-theme-dark='Colloid-Orange-Dark'
red-theme-light='Colloid-Red-Light'
red-theme-dark='Colloid-Red-Dark'
pink-theme-light='Colloid-Pink-Light'
pink-theme-dark='Colloid-Pink-Dark'
purple-theme-light='Colloid-Purple-Light'
purple-theme-dark='Colloid-Purple-Dark'
slate-theme-light='Colloid-Grey-Light'
slate-theme-dark='Colloid-Grey-Dark'

[org/gnome/shell/extensions/accent-user-theme]
# WhiteSur has no teal, so teal uses its default accent
blue-theme-light='WhiteSur-Light-solid-blue-nord'
blue-theme-dark='WhiteSur-Dark-solid-blue-nord'
teal-theme-light='WhiteSur-Light-solid-nord'
teal-theme-dark='WhiteSur-Dark-solid-nord'
green-theme-light='WhiteSur-Light-solid-green-nord'
green-theme-dark='WhiteSur-Dark-solid-green-nord'
yellow-theme-light='WhiteSur-Light-solid-yellow-nord'
yellow-theme-dark='WhiteSur-Dark-solid-yellow-nord'
orange-theme-light='WhiteSur-Light-solid-orange-nord'
orange-theme-dark='WhiteSur-Dark-solid-orange-nord'
red-theme-light='WhiteSur-Light-solid-red-nord'
red-theme-dark='WhiteSur-Dark-solid-red-nord'
pink-theme-light='WhiteSur-Light-solid-pink-nord'
pink-theme-dark='WhiteSur-Dark-solid-pink-nord'
purple-theme-light='WhiteSur-Light-solid-purple-nord'
purple-theme-dark='WhiteSur-Dark-solid-purple-nord'
slate-theme-light='WhiteSur-Light-solid-grey-nord'
slate-theme-dark='WhiteSur-Dark-solid-grey-nord'

[org/gnome/shell/extensions/accent-gtk-theme]
set-link-gtk4=true
set-theme-path='@TERMUX_HOME@/.local/share/livecd-native/themes'
blue-theme-light='WhiteSur-Light-solid-blue-nord'
blue-theme-dark='WhiteSur-Dark-solid-blue-nord'
teal-theme-light='WhiteSur-Light-solid-nord'
teal-theme-dark='WhiteSur-Dark-solid-nord'
green-theme-light='WhiteSur-Light-solid-green-nord'
green-theme-dark='WhiteSur-Dark-solid-green-nord'
yellow-theme-light='WhiteSur-Light-solid-yellow-nord'
yellow-theme-dark='WhiteSur-Dark-solid-yellow-nord'
orange-theme-light='WhiteSur-Light-solid-orange-nord'
orange-theme-dark='WhiteSur-Dark-solid-orange-nord'
red-theme-light='WhiteSur-Light-solid-red-nord'
red-theme-dark='WhiteSur-Dark-solid-red-nord'
pink-theme-light='WhiteSur-Light-solid-pink-nord'
pink-theme-dark='WhiteSur-Dark-solid-pink-nord'
purple-theme-light='WhiteSur-Light-solid-purple-nord'
purple-theme-dark='WhiteSur-Dark-solid-purple-nord'
slate-theme-light='WhiteSur-Light-solid-grey-nord'
slate-theme-dark='WhiteSur-Dark-solid-grey-nord'
