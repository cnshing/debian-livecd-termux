+/* Geometry is derived from a real gralloc allocation, never vendor ints. */
+typedef struct {
+ AHardwareBuffer *buffer;
+ AHardwareBuffer_Desc desc;
+ uint32_t stride, uv_offset, size;
+ int nv21;
+} YuvBuffer;
+static void yuv_buffer_close(YuvBuffer *b)
+{
+ if (b->buffer) z.AHardwareBuffer_release(b->buffer);
+ memset(b, 0, sizeof(*b));
+}
+static int yuv_buffer_new(YuvBuffer *b, unsigned width, unsigned height)
+{
+ pthread_once(&z_once, z_load);
+ if (!z.ready || !width || !height || (width | height) & 1) return -1;
+ b->desc = (AHardwareBuffer_Desc){.width=width, .height=height, .layers=1,
+  .format=AHARDWAREBUFFER_FORMAT_Y8Cb8Cr8_420,
+  .usage=AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+         AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN | AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN};
+ if (z.AHardwareBuffer_allocate(&b->desc, &b->buffer)) return -1;
+ z.AHardwareBuffer_describe(b->buffer, &b->desc);
+ AHardwareBuffer_Planes p = {0};
+ if (z.AHardwareBuffer_lockPlanes(b->buffer, AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN,
+                               -1, NULL, &p)) goto fail;
+ const YuvNativeHandle *handle = z.handle(b->buffer);
+ off_t size = handle && handle->numFds == 2 ? lseek(handle->data[0], 0, SEEK_END) : -1;
