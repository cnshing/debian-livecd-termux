+  p.planes[0].pixelStride == 1 && p.planes[1].pixelStride == 2 &&
+  p.planes[2].pixelStride == 2 && p.planes[0].rowStride >= width &&
+  p.planes[1].rowStride == p.planes[0].rowStride &&
+  p.planes[2].rowStride == p.planes[0].rowStride &&
+  (u == v + 1 || v == u + 1) && u > y && v > y &&
+  size > 0 && size <= MAX_ENCODE_FRAME;
+ if (valid) {
+  b->stride = p.planes[0].rowStride;
+  b->nv21 = u == v + 1;
+  uintptr_t offset = (u < v ? u : v) - y;
+  valid = offset <= UINT32_MAX && offset >= (uint64_t)b->stride * height &&
+   offset + (uint64_t)b->stride * (height / 2) <= (uint64_t)size;
+  b->uv_offset = (uint32_t)offset;
+  b->size = (uint32_t)size;
+ }
+ if (z.AHardwareBuffer_unlock(b->buffer, NULL) || !valid) goto fail;
+ return 0;
+fail:
+ yuv_buffer_close(b);
+ return -1;
+}
