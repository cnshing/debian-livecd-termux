+    0x00, 0x00, 0x00, 0x01, 0x40, 0x01, 0x0c, 0x01, 0xff, 0xff, 0x04, 0x08, 0x00, 0x00, 0x03, 0x00,
+    0x9d, 0xa8, 0x00, 0x00, 0x03, 0x00, 0x00, 0x1e, 0xba, 0x02, 0x40, 0x00, 0x00, 0x00, 0x01, 0x42,
+    0x01, 0x01, 0x04, 0x08, 0x00, 0x00, 0x03, 0x00, 0x9d, 0xa8, 0x00, 0x00, 0x03, 0x00, 0x00, 0x1e,
+    0xa0, 0x30, 0x81, 0x84, 0xd9, 0x6e, 0xa4, 0x93, 0x2b, 0xc0, 0x5a, 0x02, 0x00, 0x00, 0x03, 0x00,
+    0x02, 0x00, 0x00, 0x03, 0x00, 0x02, 0x10, 0x00, 0x00, 0x00, 0x01, 0x44, 0x01, 0xc1, 0x72, 0xb0,
+    0x22, 0x40, 0x00, 0x00, 0x01, 0x28, 0x01, 0xaf, 0x78, 0xeb, 0xae, 0xfb, 0xfe, 0x75, 0x57, 0xca,
+    0xc2, 0xa7, 0x9e, 0x4e, 0x84,
+};
+static const uint8_t probe_vp9_profile2[] = {
+    0x92, 0x49, 0x83, 0x42, 0x00, 0x02, 0xf8, 0x02, 0xfb, 0x00, 0x1c, 0x12, 0x0e, 0x0c, 0x49, 0x00,
+    0x00, 0x18, 0x60, 0x00, 0x00, 0x67, 0x36, 0x91, 0x3b, 0xc2, 0x80, 0xd7, 0x00,
+};
+
+static bool probe_ten_bit_decoder(const char *mime, const uint8_t *unit, size_t len,
+                                  char *component, size_t component_size)
+{
+    bool ok = false;
+    AMediaFormat *fmt = NULL;
+    AMediaCodec *codec = AMediaCodec_createDecoderByType(mime);
+    if (!codec)
+        return false;
+    char *name = NULL;
+    if (AMediaCodec_getName(codec, &name) != AMEDIA_OK || !name)
+        goto out;
+    snprintf(component, component_size, "%s", name);
+    bool qualcomm = !strncmp(name, "OMX.qcom.", 9) || !strncmp(name, "c2.qti.", 7);
+    AMediaCodec_releaseName(codec, name);
+    if (!qualcomm)
+        goto out;
+    fmt = AMediaFormat_new();
+    AMediaFormat_setString(fmt, TVA_MF_KEY_MIME, mime);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_WIDTH, 96);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_HEIGHT, 96);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_COLOR_FORMAT, COLOR_FORMAT_YUV420_FLEXIBLE);
+    if (AMediaCodec_configure(codec, fmt, NULL, NULL, 0) != AMEDIA_OK ||
+        AMediaCodec_start(codec) != AMEDIA_OK)
+        goto out;
+    int sent = 0;
+    int32_t color = -1, stride = 0;
+    for (int i = 0; i < 300; i++) {
+        if (sent < 2) {
+            ssize_t in = AMediaCodec_dequeueInputBuffer(codec, 10000);
+            if (in >= 0) {
+                size_t cap = 0;
+                uint8_t *buffer = AMediaCodec_getInputBuffer(codec, (size_t)in, &cap);
+                if (!buffer || cap < len)
+                    break;
+                if (!sent)
+                    memcpy(buffer, unit, len);
+                AMediaCodec_queueInputBuffer(codec, (size_t)in, 0, sent ? 0 : len, 0,
+                                             sent ? AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM : 0);
+                sent++;
+            }
+        }
+        AMediaCodecBufferInfo info;
+        ssize_t out = AMediaCodec_dequeueOutputBuffer(codec, &info, 10000);
+        if (out == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+            AMediaFormat *of = AMediaCodec_getOutputFormat(codec);
+            if (of) {
+                AMediaFormat_getInt32(of, TVA_MF_KEY_COLOR_FORMAT, &color);
+                AMediaFormat_getInt32(of, TVA_MF_KEY_STRIDE, &stride);
+                AMediaFormat_delete(of);
+            }
+        } else if (out >= 0) {
+            /* A P010 picture of 96x96 holds at least 96*2 bytes per row. */
+            ok = info.size >= 96 * 96 * 3 && color_format_is_p010(color) && stride >= 192;
+            AMediaCodec_releaseOutputBuffer(codec, (size_t)out, false);
+            break;
+        }
+    }
+    dlog(1, "%s 10-bit probe: %s color=0x%x stride=%d -> %s", mime, component,
+         (unsigned)color, stride, ok ? "P010" : "not offered");
+out:
+    AMediaCodec_stop(codec);
+    AMediaCodec_delete(codec);
+    if (fmt)
+        AMediaFormat_delete(fmt);
+    return ok;
+}
