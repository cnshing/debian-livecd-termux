+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * One SCM_RIGHTS fd is attached to exactly one marker byte. Metadata follows
+ * separately, so short stream reads cannot lose or duplicate ancillary data. */
+#ifndef TVA_FD_H
+#define TVA_FD_H
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+static int tva_fd_wait(int socket, short events, int64_t deadline)
+{
+ for (;;) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  int64_t remaining = deadline - ((int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
+  if (remaining <= 0) return -1;
+  struct pollfd p = {.fd=socket, .events=events};
+  int r = poll(&p, 1, (int)remaining);
+  if (r < 0 && errno == EINTR) continue;
+  return r > 0 && (p.revents & events) ? 0 : -1;
+ }
+}
+static int tva_transfer_fd(int socket, int sending, int *fd)
+{
+ struct timespec ts;
+ clock_gettime(CLOCK_MONOTONIC, &ts);
+ int64_t deadline = (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000 + 5000;
+ for (;;) {
+  if (tva_fd_wait(socket, sending ? POLLOUT : POLLIN, deadline)) return -1;
+  unsigned char marker = sending ? 0x46 : 0;
+  struct iovec io = {.iov_base=&marker, .iov_len=1};
+  union { struct cmsghdr align; unsigned char data[CMSG_SPACE(16 * sizeof(int))]; } control;
+  memset(&control, 0, sizeof(control));
+  struct msghdr msg = {.msg_iov=&io, .msg_iovlen=1,
+   .msg_control=control.data, .msg_controllen=sizeof(control.data)};
+  if (sending) {
+   msg.msg_controllen = CMSG_SPACE(sizeof(int));
+   struct cmsghdr *c = CMSG_FIRSTHDR(&msg);
+   c->cmsg_level=SOL_SOCKET; c->cmsg_type=SCM_RIGHTS;
+   c->cmsg_len=CMSG_LEN(sizeof(int)); memcpy(CMSG_DATA(c), fd, sizeof(int));
+  }
+  ssize_t n = sending ? sendmsg(socket, &msg, MSG_NOSIGNAL | MSG_DONTWAIT)
+                       : recvmsg(socket, &msg, MSG_CMSG_CLOEXEC | MSG_DONTWAIT);
+  if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+  if (sending) return n == 1 ? 0 : -1;
+  int received=-1, count=0, bad=(n != 1 || marker != 0x46 ||
+                                     (msg.msg_flags & (MSG_CTRUNC | MSG_TRUNC)));
+  if (n < 0) return -1;
+  for (struct cmsghdr *c=CMSG_FIRSTHDR(&msg); c; c=CMSG_NXTHDR(&msg,c)) {
+   if (c->cmsg_level != SOL_SOCKET || c->cmsg_type != SCM_RIGHTS ||
+       c->cmsg_len < CMSG_LEN(0)) { bad=1; continue; }
+   size_t bytes=c->cmsg_len-CMSG_LEN(0);
+   if (bytes % sizeof(int)) bad=1;
+   for (size_t i=0; i<bytes/sizeof(int); i++) {
+    int value; memcpy(&value, (char *)CMSG_DATA(c)+i*sizeof(int), sizeof(int));
+    if (!count++) received=value; else close(value);
+   }
+  }
+  if (bad || count != 1) { if (received >= 0) close(received); return -1; }
+  *fd=received;
+  return 0;
+ }
+}
+#endif
