+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+static VkResult
+wsi_create_ahb_image_mem(const struct wsi_swapchain *chain,
+                       const struct wsi_image_info *info,
+                       struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   uint32_t format;
+   switch (info->create.format) {
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+      break;
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      format = 5;
+      break;
+   default:
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+
+   AHardwareBuffer_Desc desc = {
+      .width = info->create.extent.width,
+      .height = info->create.extent.height,
+      .layers = 1,
+      .format = format,
+      .usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT |
+               AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+               AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN |
+               AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+   };
+   if (AHardwareBuffer_allocate(&desc, &image->ahb) != 0)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   if (!image->ahb)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   AHardwareBuffer_describe(image->ahb, &desc);
+   if (desc.width != info->create.extent.width ||
+       desc.height != info->create.extent.height || desc.layers != 1 ||
+       desc.format != format || desc.stride < desc.width ||
+       desc.stride > UINT32_MAX / 4)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   VkAndroidHardwareBufferPropertiesANDROID props = {
+      .sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID,
+   };
+   VkResult result = wsi->GetAndroidHardwareBufferPropertiesANDROID(
+      chain->device, image->ahb, &props);
+   if (result != VK_SUCCESS)
+      return result;
+   if (!props.allocationSize || !props.memoryTypeBits)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   uint32_t memory_type = wsi_select_device_memory_type(wsi, props.memoryTypeBits);
+   if (memory_type == UINT32_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   VkImportAndroidHardwareBufferInfoANDROID import = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+      .buffer = image->ahb,
+   };
+   VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &import,
+      .image = image->image,
+   };
+   VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated,
+      .allocationSize = props.allocationSize,
+      .memoryTypeIndex = memory_type,
+   };
+   result = wsi->AllocateMemory(chain->device, &alloc, &chain->alloc,
+                                &image->memory);
+   if (result != VK_SUCCESS)
+      return result;
+   image->num_planes = 1;
+   image->row_pitches[0] = desc.stride * 4;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_configure_ahb_image(const struct wsi_swapchain *chain,
+                        const VkSwapchainCreateInfoKHR *create,
+                        struct wsi_image_info *info)
+{
+   if (!chain->wsi->GetAndroidHardwareBufferPropertiesANDROID)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+   if (create->flags & VK_SWAPCHAIN_CREATE_PROTECTED_BIT_KHR)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   VkResult result = wsi_configure_image(chain, create,
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID, info);
+   if (result != VK_SUCCESS)
+      return result;
+   info->image_type = WSI_IMAGE_TYPE_AHB;
+   info->create_mem = wsi_create_ahb_image_mem;
+   return VK_SUCCESS;
+}
+#endif
+
 static VkResult
 configure_image(const struct wsi_swapchain *chain,
                 const VkSwapchainCreateInfoKHR *pCreateInfo,
