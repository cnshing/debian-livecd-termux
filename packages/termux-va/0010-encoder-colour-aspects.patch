+/* MediaFormat colour values (MediaFormat.COLOR_* and the framework's
+ * ColorUtils, which also accepts sRGB = 2) for H.273 code points.  Zero
+ * leaves a key unset, so the encoder keeps its default for it. */
+static int encoder_color_standard(unsigned primaries, unsigned matrix)
+{
+    switch (matrix) {
+    case 1:  return 1;                          /* BT709 */
+    case 5:  return 2;                          /* BT601_PAL */
+    case 6:  return primaries == 5 ? 2 : 4;     /* BT601_NTSC */
+    case 9:  return 6;                          /* BT2020 */
+    }
+    switch (primaries) {
+    case 1:  return 1;
+    case 5:  return 2;
+    case 6: case 7: return 4;
+    case 9:  return 6;
+    }
+    return 0;
+}
+
+static int encoder_color_transfer(unsigned transfer)
+{
+    switch (transfer) {
+    case 1: case 6: case 14: case 15: return 3; /* SDR_VIDEO (BT.709/601/2020) */
+    case 8:  return 1;                          /* LINEAR */
+    case 13: return 2;                          /* sRGB */
+    case 16: return 6;                          /* ST2084 */
+    case 18: return 7;                          /* HLG */
+    }
+    return 0;
+}
+
+static void encoder_set_color(Session *s, AMediaFormat *fmt)
+{
+    uint32_t c = s->enc_color;
+    if (!(c & ENC_XFER_COLOR))
+        return;
+    int range = (c & ENC_XFER_FULL_RANGE) ? 1 : 2;
+    int standard = encoder_color_standard(ENC_XFER_PRIMARIES(c), ENC_XFER_MATRIX(c));
+    int transfer = encoder_color_transfer(ENC_XFER_TRANSFER(c));
+    AMediaFormat_setInt32(fmt, "color-range", range);
+    if (standard)
+        AMediaFormat_setInt32(fmt, "color-standard", standard);
+    if (transfer)
+        AMediaFormat_setInt32(fmt, "color-transfer", transfer);
+    dlog(1, "[%d] encoder colour: range=%d standard=%d transfer=%d "
+            "(primaries=%u transfer=%u matrix=%u)", s->id, range, standard, transfer,
+         ENC_XFER_PRIMARIES(c), ENC_XFER_TRANSFER(c), ENC_XFER_MATRIX(c));
+}
+
