+/* Whether Qualcomm's HEVC encoder turns one Venus P010 picture into a Main10 stream
+ * (SPS general_profile_idc 2). */
+static bool probe_ten_bit_encoder(char *component, size_t component_size)
+{
+    bool ok = false;
+    AMediaFormat *fmt = NULL;
+    AMediaCodec *codec = AMediaCodec_createEncoderByType("video/hevc");
+    if (!codec)
+        return false;
+    char *name = NULL;
+    if (AMediaCodec_getName(codec, &name) != AMEDIA_OK || !name)
+        goto out;
+    snprintf(component, component_size, "%s", name);
+    bool qualcomm = !strncmp(name, "OMX.qcom.", 9) || !strncmp(name, "c2.qti.", 7);
+    AMediaCodec_releaseName(codec, name);
+    if (!qualcomm)
+        goto out;
+    fmt = AMediaFormat_new();
+    AMediaFormat_setString(fmt, TVA_MF_KEY_MIME, "video/hevc");
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_WIDTH, 256);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_HEIGHT, 144);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_BIT_RATE, 1000000);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_FRAME_RATE, 30);
+    AMediaFormat_setInt32(fmt, TVA_MF_KEY_I_FRAME_INTERVAL, 1);
+    AMediaFormat_setInt32(fmt, "color-format", COLOR_QCOM_YUV420_P010_VENUS);
+    AMediaFormat_setInt32(fmt, "profile", 4096);
+    if (AMediaCodec_configure(codec, fmt, NULL, NULL, 1) != AMEDIA_OK ||
+        AMediaCodec_start(codec) != AMEDIA_OK)
+        goto out;
+    int sent = 0;
+    for (int i = 0; i < 300 && !ok; i++) {
+        if (sent < 2) {
+            ssize_t in = AMediaCodec_dequeueInputBuffer(codec, 10000);
+            if (in >= 0) {
+                size_t cap = 0;
+                uint8_t *buffer = AMediaCodec_getInputBuffer(codec, (size_t)in, &cap);
+                if (!buffer)
+                    break;
+                for (size_t k = 0; k + 1 < cap; k += 2) {   /* mid grey, high 10 bits */
+                    buffer[k] = 0x00;
+                    buffer[k + 1] = 0x80;
+                }
+                AMediaCodec_queueInputBuffer(codec, (size_t)in, 0, sent ? 0 : cap, 0,
+                                             sent ? AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM : 0);
+                sent++;
+            }
+        }
+        AMediaCodecBufferInfo info;
+        ssize_t out = AMediaCodec_dequeueOutputBuffer(codec, &info, 10000);
+        if (out >= 0) {
+            size_t size = 0;
+            uint8_t *data = AMediaCodec_getOutputBuffer(codec, (size_t)out, &size);
+            for (int32_t k = 0; data && k + 6 < info.size; k++) {
+                const uint8_t *b = data + info.offset + k;
+                if (!b[0] && !b[1] && b[2] == 1 && ((b[3] >> 1) & 63) == 33) {
+                    ok = (b[6] & 31) == 2;   /* general_profile_idc */
+                    break;
+                }
+            }
+            bool end = info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM;
+            AMediaCodec_releaseOutputBuffer(codec, (size_t)out, false);
+            if (end)
+                break;
+        }
+    }
+    dlog(1, "video/hevc 10-bit encode probe: %s -> %s", component, ok ? "Main10" : "not offered");
+out:
+    AMediaCodec_stop(codec);
+    AMediaCodec_delete(codec);
+    if (fmt)
+        AMediaFormat_delete(fmt);
+    return ok;
+}
