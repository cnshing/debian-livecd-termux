From: LiveCD Termux maintainers
Subject: [PATCH] Follow a caller's bitrate change on CPU input

Firefox's WebRTC changes AVCodecContext.bit_rate between pictures when
congestion control moves its target (with the Firefox patch that lets it do
so for VA-API encoders). Rate control was built once at open, so the change
was ignored. On the CPU-input path, notice a changed bit_rate, scale the
bitrate the interval correction starts from, and send the new rate control
with the next picture.

--- a/libavcodec/vaapi_encode.c
+++ b/libavcodec/vaapi_encode.c
@@ -2157,16 +2157,31 @@ static void vaapi_encode_cpu_rate_update(AVCodecContext *avctx, const AVFrame *f
 {
     VAAPIEncodeContext *ctx = avctx->priv_data;
     int64_t pts, delta, bits, current = ctx->rc_params.bits_per_second;
+    int caller_changed = 0;
 
-    if (ctx->cpu_base_bits <= 0 || frame->pts == AV_NOPTS_VALUE ||
-        avctx->time_base.num <= 0 || avctx->time_base.den <= 0)
+    if (ctx->cpu_base_bits <= 0)
         return;
+    /* A caller may change bit_rate between pictures, as Firefox's WebRTC does
+     * when congestion control moves its target. Follow it in proportion,
+     * keeping the rate control's own target percentage. */
+    if (avctx->bit_rate > 0 && ctx->cpu_caller_bits > 0 &&
+        avctx->bit_rate != ctx->cpu_caller_bits) {
+        av_log(avctx, AV_LOG_VERBOSE, "VAAPI: caller bitrate %"PRId64" -> %"PRId64".\n",
+               ctx->cpu_caller_bits, (int64_t)avctx->bit_rate);
+        ctx->cpu_base_bits = av_rescale(ctx->cpu_base_bits, avctx->bit_rate,
+                                        ctx->cpu_caller_bits);
+        ctx->cpu_caller_bits = avctx->bit_rate;
+        caller_changed = 1;
+    }
+    if (frame->pts == AV_NOPTS_VALUE ||
+        avctx->time_base.num <= 0 || avctx->time_base.den <= 0)
+        goto apply;
     pts = av_rescale_q(frame->pts, avctx->time_base, AV_TIME_BASE_Q);
     delta = ctx->cpu_last_pts == AV_NOPTS_VALUE ? 0 : pts - ctx->cpu_last_pts;
     ctx->cpu_last_pts = pts;
     /* A pause or a jump in the timestamps is not a frame rate. */
     if (delta <= 0 || delta > 2 * AV_TIME_BASE)
-        return;
+        goto apply;
     /* About a second of pictures: a capture timer alternates between 33 and
      * 50 ms, and a shorter average would follow it and change the bitrate
      * several times a second. */
@@ -2175,17 +2190,27 @@ static void vaapi_encode_cpu_rate_update(AVCodecContext *avctx, const AVFrame *f
                             (ctx->cpu_intervals + 1);
         /* The first intervals after a start are often irregular. */
         if (++ctx->cpu_intervals < 8)
-            return;
+            goto apply;
     } else {
         ctx->cpu_interval += (delta - ctx->cpu_interval) / 32;
     }
-    bits = av_rescale(ctx->cpu_base_bits,
-                      ctx->cpu_interval * ctx->cpu_nominal_rate.num,
-                      (int64_t)AV_TIME_BASE * ctx->cpu_nominal_rate.den);
-    bits = av_clip64(bits, FFMAX(ctx->cpu_base_bits / 8, 1),
-                     FFMIN(ctx->cpu_base_bits * 8, UINT32_MAX));
+apply:
+    if (ctx->cpu_intervals < 8) {
+        /* No measured rate yet: only a caller's change is applied. */
+        if (!caller_changed)
+            return;
+        bits = FFMIN(ctx->cpu_base_bits, UINT32_MAX);
+    } else {
+        bits = av_rescale(ctx->cpu_base_bits,
+                          ctx->cpu_interval * ctx->cpu_nominal_rate.num,
+                          (int64_t)AV_TIME_BASE * ctx->cpu_nominal_rate.den);
+        bits = av_clip64(bits, FFMAX(ctx->cpu_base_bits / 8, 1),
+                         FFMIN(ctx->cpu_base_bits * 8, UINT32_MAX));
+    }
     /* Ordinary jitter must not reach the encoder as a stream of changes. */
-    if (FFABS(bits - current) * 10 <= current)
+    if (!caller_changed && FFABS(bits - current) * 10 <= current)
+        return;
+    if (bits == current)
         return;
 
     av_log(avctx, AV_LOG_VERBOSE, "VAAPI: pictures arrive every %"PRId64" us, "
@@ -2392,8 +2417,10 @@ av_cold int ff_vaapi_encode_init(AVCodecContext *avctx)
     err = vaapi_encode_init_rate_control(avctx);
     if (err < 0)
         goto fail;
-    if (ctx->cpu_upload && ctx->va_rc_mode != VA_RC_CQP)
+    if (ctx->cpu_upload && ctx->va_rc_mode != VA_RC_CQP) {
         ctx->cpu_base_bits = ctx->rc_params.bits_per_second;
+        ctx->cpu_caller_bits = avctx->bit_rate;
+    }
 
     err = vaapi_encode_init_gop_structure(avctx);
     if (err < 0)
--- a/libavcodec/vaapi_encode.h
+++ b/libavcodec/vaapi_encode.h
@@ -158,6 +158,7 @@ typedef struct VAAPIEncodeContext {
     // rate; its bitrate then follows the measured interval between pictures.
     AVRational      cpu_nominal_rate;  // frame rate given to the driver
     int64_t         cpu_base_bits;     // rc_params.bits_per_second at that rate
+    int64_t         cpu_caller_bits;   // avctx->bit_rate cpu_base_bits follows
     int64_t         cpu_last_pts;      // microseconds
     int64_t         cpu_interval;      // smoothed picture interval, microseconds
     int             cpu_intervals;     // intervals measured so far, up to 32
