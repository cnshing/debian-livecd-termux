diff -ruN a/src/dummy/up-device-android-battery.c b/src/dummy/up-device-android-battery.c
--- a/src/dummy/up-device-android-battery.c
+++ b/src/dummy/up-device-android-battery.c
@@ -0,0 +1,472 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: t; c-basic-offset: 8 -*-
+ *
