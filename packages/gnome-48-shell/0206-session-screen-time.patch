+// SPDX-License-Identifier: GPL-2.0-or-later
+// Session-local activity for screen-time accounting without logind. This does
+// not expose Android users, authorization, device power, or other login APIs.
+import Meta from 'gi://Meta';
+import * as Signals from '../signals.js';
+
+// Screen blanking is disabled in the native profile (idle-delay=0). Keep the
+// accounting threshold independent so idle desktop time is still excluded.
+export const IDLE_THRESHOLD_MS = 60 * 1000;
+
+export class SessionActivityUser extends Signals.EventEmitter {
+    constructor(idleMonitor = global.backend.get_core_idle_monitor()) {
+        super();
+        this._monitor = idleMonitor;
+        this._idleHint = idleMonitor.get_idletime() >= IDLE_THRESHOLD_MS;
+        this._activeWatch = 0;
+        this._idleWatch = idleMonitor.add_idle_watch_full(
+            IDLE_THRESHOLD_MS, () => this._onIdle(),
+            Meta.IdleMonitorWatchFlags.UNINHIBITABLE);
+        if (this._idleHint)
+            this._watchActive();
+    }
+
+    get State() {
+        return 'active';
+    }
+
+    get IdleHint() {
+        return this._idleHint;
+    }
+
+    _watchActive() {
+        if (!this._activeWatch) {
+            this._activeWatch = this._monitor.add_user_active_watch(() => {
+                this._activeWatch = 0; // One-shot watch, removed by Mutter.
+                this._setIdle(false);
+            });
+        }
+    }
+
+    _onIdle() {
+        this._watchActive();
+        this._setIdle(true);
+    }
+
+    _setIdle(idle) {
+        if (this._idleHint === idle)
+            return;
+        this._idleHint = idle;
+        this.emit('g-properties-changed');
+    }
+
+    destroy() {
+        if (this._idleWatch)
+            this._monitor.remove_watch(this._idleWatch);
+        if (this._activeWatch)
+            this._monitor.remove_watch(this._activeWatch);
+        this._idleWatch = this._activeWatch = 0;
+    }
+}
