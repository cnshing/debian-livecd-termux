+++ b/js/misc/termux/accountsService.js
@@ -0,0 +1,152 @@
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+
+export const UserPasswordMode = {
+    NONE: 0,
+    REGULAR: 1,
+    ADMINISTRATOR: 2,
+};
+
+const TermuxUser = GObject.registerClass({
+    Signals: {
+        'changed': {},
+    },
+
+    Properties: {
+        'is-loaded': GObject.ParamSpec.boolean(
+            'is-loaded',
+            'Is Loaded',
+            'Whether user information is loaded',
+            GObject.ParamFlags.READABLE,
+            true
+        ),
+
+        'locked': GObject.ParamSpec.boolean(
+            'locked',
+            'Locked',
+            'Whether the user is locked',
+            GObject.ParamFlags.READABLE,
+            false
+        ),
+
+        'password-mode': GObject.ParamSpec.int(
+            'password-mode',
+            'Password Mode',
+            'Password mode',
+            GObject.ParamFlags.READABLE,
+            0,
+            2,
+            0
+        ),
+    },
+}, class TermuxUser extends GObject.Object {
+    _init(userName = GLib.get_user_name()) {
+        super._init();
+
+        this._userName = userName;
+        this._realName = GLib.get_real_name() || userName;
+    }
+
+    get_user_name() {
+        return this._userName;
+    }
+
+    get_real_name() {
+        return this._realName;
+    }
+
+    get_icon_file() {
+        return null;
+    }
+
+    get_password_mode() {
+        return UserPasswordMode.NONE;
+    }
+
+    is_logged_in() {
+        return true;
+    }
+
+    get is_loaded() {
+        return true;
+    }
+
+    get locked() {
+        return false;
+    }
+
+    get password_mode() {
+        return UserPasswordMode.NONE;
+    }
+});
+
+const TermuxUserManager = GObject.registerClass({
+    Properties: {
+        'is-loaded': GObject.ParamSpec.boolean(
+            'is-loaded',
+            'Is Loaded',
+            'Whether the user database is loaded',
+            GObject.ParamFlags.READABLE,
+            true
+        ),
+
+        'has-multiple-users': GObject.ParamSpec.boolean(
+            'has-multiple-users',
+            'Has Multiple Users',
+            'Whether multiple users exist',
+            GObject.ParamFlags.READABLE,
+            false
+        ),
+    },
+
+    Signals: {
+        'user-added': {
+            param_types: [GObject.TYPE_OBJECT],
+        },
+
+        'user-removed': {
+            param_types: [GObject.TYPE_OBJECT],
+        },
+    },
+}, class TermuxUserManager extends GObject.Object {
+    static get_default() {
+        if (!this._default)
+            this._default = new TermuxUserManager();
+
+        return this._default;
+    }
+
+    _init() {
+        super._init();
+
+        this._user = new TermuxUser(GLib.get_user_name());
+    }
+
+    get is_loaded() {
+        return true;
+    }
+
+    get has_multiple_users() {
+        return false;
+    }
+
+    can_switch() {
+        return false;
+    }
+
+    get_user(userName) {
+        if (!userName)
+            return null;
+
+        return userName === this._user.get_user_name()
+            ? this._user
+            : null;
+    }
+
+    list_users() {
+        return [this._user];
+    }
+});
+
+export const UserManager = TermuxUserManager;
+export const User = TermuxUser;
