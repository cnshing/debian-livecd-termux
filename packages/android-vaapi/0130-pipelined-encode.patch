+/* Reader thread of an encoder: receives packets in submission order. */
+static int
+tva_encode_reader_thread(void *param)
+{
+    struct tva_codec *c = param;
+    size_t cap = TVA_MAX_UNIT_BYTES;
+    uint8_t *buf = malloc(cap);
+    for (;;) {
+        size_t len = 0;
+        uint32_t flags = 0, pts = 0;
+        if (!buf || tva_session_receive_packet(c->sess, buf, cap, &len,
+                                               &flags, &pts) != TVA_OK) {
+            mtx_lock(&c->pend_mutex);
+            c->enc_failed = true;
+            u_cnd_monotonic_broadcast(&c->pend_cond);
+            mtx_unlock(&c->pend_mutex);
+            break;
+        }
+        uint8_t *copy = malloc(len ? len : 1);
+        if (copy)
+            memcpy(copy, buf, len);
+        mtx_lock(&c->pend_mutex);
+        if (!copy || c->enc_received >= c->enc_sent) {
+            /* An unrequested packet: the stream is out of step. */
+            free(copy);
+            c->enc_failed = true;
+            u_cnd_monotonic_broadcast(&c->pend_cond);
+            mtx_unlock(&c->pend_mutex);
+            break;
+        }
+        struct tva_enc_job *job = &c->enc_jobs[c->enc_received % TVA_ENC_DEPTH];
+        c->enc_received++;
+        if (job->key_wanted && !(flags & 1))
+            TVA_TRACE("encoder returned a non-key frame for a requested key frame");
+        job->data = copy;
+        job->len = len;
+        job->ready = true;
+        u_cnd_monotonic_broadcast(&c->pend_cond);
+        mtx_unlock(&c->pend_mutex);
+    }
+    free(buf);
+    return 0;
+}
+
+/* Waits for pictures up to sequence number seq and writes their packets
+ * into their coded buffers, oldest first.  Application thread only.
+ * Returns the packet length of seq, 0 on failure. */
+static size_t
+tva_encode_complete(struct tva_codec *c, uint64_t seq)
+{
+    size_t result = 0;
+    mtx_lock(&c->pend_mutex);
+    while (c->enc_done < seq && c->enc_done < c->enc_sent) {
+        struct tva_enc_job *job = &c->enc_jobs[c->enc_done % TVA_ENC_DEPTH];
+        while (!job->ready && !c->enc_failed && !c->quitting)
+            u_cnd_monotonic_wait(&c->pend_cond, &c->pend_mutex);
+        if (!job->ready) {
+            mtx_unlock(&c->pend_mutex);
+            tva_mark_broken(c);
+            return 0;
+        }
+        uint8_t *data = job->data;
+        size_t len = job->len;
+        struct pipe_resource *dest = job->dest;
+        job->data = NULL;
+        job->dest = NULL;
+        job->ready = false;
+        c->enc_done++;
+        bool target = c->enc_done == seq;
+        mtx_unlock(&c->pend_mutex);
+        bool ok = tva_encode_write_destination(c, dest, data, len) == 0;
+        free(data);
+        pipe_resource_reference(&dest, NULL);
+        if (!ok) {
+            tva_mark_broken(c);
+            return 0;
+        }
+        if (target)
+            result = len;
+        mtx_lock(&c->pend_mutex);
+    }
+    mtx_unlock(&c->pend_mutex);
+    return result;
+}
