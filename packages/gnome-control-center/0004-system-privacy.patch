diff --git a/panels/common/cc-hostname.c b/panels/common/cc-hostname.c
--- a/panels/common/cc-hostname.c
+++ b/panels/common/cc-hostname.c
@@ -33,6 +33,11 @@
 #include "hostname-helper.h"
 #include "shell/cc-object-storage.h"
 
+#ifdef __ANDROID__
+#include <sys/system_properties.h>
+#include <sys/utsname.h>
+#endif
+
 #define HOSTNAME_BUS_NAME "org.freedesktop.hostname1"
 #define HOSTNAME_OBJECT_PATH "/org/freedesktop/hostname1"
 
@@ -45,6 +50,55 @@ struct _CcHostname
 
 G_DEFINE_TYPE (CcHostname, cc_hostname, G_TYPE_OBJECT)
 
+#ifdef __ANDROID__
+static gchar *
+android_property (const gchar *name)
+{
+  char value[PROP_VALUE_MAX] = "";
+
+  __system_property_get (name, value);
+  return g_strdup (value);
+}
+
+/* Android has no hostnamed: describe the device from its build properties.
+ * The device name in Android's settings is not readable by apps. */
+static gchar *
+android_hostname_property (const gchar *property)
+{
+  struct utsname name;
+
+  if (g_str_equal (property, "HardwareVendor"))
+    {
+      g_autofree gchar *vendor = android_property ("ro.product.manufacturer");
+
+      if (*vendor != '\0')
+        *vendor = g_ascii_toupper (*vendor);
+      return g_steal_pointer (&vendor);
+    }
+  if (g_str_equal (property, "HardwareModel"))
+    return android_property ("ro.product.model");
+  if (g_str_equal (property, "PrettyHostname"))
+    {
+      g_autofree gchar *vendor = android_hostname_property ("HardwareVendor");
+      g_autofree gchar *model = android_hostname_property ("HardwareModel");
+
+      return g_strstrip (g_strdup_printf ("%s %s", vendor, model));
+    }
+  if (g_str_equal (property, "Hostname") || g_str_equal (property, "StaticHostname"))
+    return g_strdup (g_get_host_name ());
+  if (g_str_equal (property, "FirmwareVersion"))
+    return android_property ("ro.bootloader");
+  if (g_str_equal (property, "Chassis"))
+    return g_strdup ("handset");
+  if (uname (&name) == 0 && g_str_equal (property, "KernelName"))
+    return g_strdup (name.sysname);
+  if (uname (&name) == 0 && g_str_equal (property, "KernelRelease"))
+    return g_strdup (name.release);
+
+  return g_strdup ("");
+}
+#endif
+
 static void
 cc_hostname_dispose (GObject *object)
 {
@@ -61,6 +115,10 @@ cc_hostname_constructed (GObject *object)
   CcHostname *self = CC_HOSTNAME (object);
   g_autoptr(GError) error = NULL;
 
+#ifdef __ANDROID__
+  return;
+#endif
+
   self->proxy = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SYSTEM,
                                                G_DBUS_PROXY_FLAGS_NONE,
                                                NULL,
@@ -116,6 +174,10 @@ cc_hostname_get_property (CcHostname  *self,
   g_return_val_if_fail (CC_IS_HOSTNAME (self), NULL);
   g_return_val_if_fail (property != NULL, NULL);
 
+#ifdef __ANDROID__
+  return android_hostname_property (property);
+#endif
+
   if (!self->proxy)
     return g_strdup ("");
 
@@ -183,6 +245,12 @@ cc_hostname_set_hostname (CcHostname  *self,
   g_return_if_fail (CC_IS_HOSTNAME (self));
   g_return_if_fail (hostname != NULL);
 
+  if (self->proxy == NULL)
+    {
+      g_warning ("Cannot set the hostname without hostnamed");
+      return;
+    }
+
   g_debug ("Setting PrettyHostname to '%s'", hostname);
   pretty_result = g_dbus_proxy_call_sync (self->proxy,
                                           "SetPrettyHostname",
