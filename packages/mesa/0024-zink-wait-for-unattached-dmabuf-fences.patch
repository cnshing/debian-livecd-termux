Zink: finish a submitted dma-buf batch when its fence cannot be attached.

The Galaxy S20 kernel lacks IMPORT/EXPORT_SYNC_FILE. Return an accurate
attach result and wait on the batch timeline before notifying flush completion
when attaching any plane fails. A signalled SYNC_FD (-1) needs no attachment.
Keep patches 0021-0023 for ICDs without SYNC_FD support.

--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -2503,8 +2503,7 @@
    int ret = drmIoctl(fd, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &export);
    close(fd);
    if (ret) {
-      if (errno == ENOTTY || errno == EBADF || errno == ENOSYS) {
-         assert(!"how did this fail?");
+      if (errno == ENOTTY || errno == ENOSYS) {
          return VK_NULL_HANDLE;
       } else {
          mesa_loge("MESA: failed to import sync file '%s'", strerror(errno));
@@ -2549,6 +2548,9 @@
       return false;
    }
 
+   if (sync_file_fd == -1)
+      return true;
+
    bool ret = false;
    int fd = zink_resource_get_dma_buf(screen, res);
    if (fd != -1) {
@@ -2556,20 +2558,13 @@
          .flags = write ? DMA_BUF_SYNC_RW : DMA_BUF_SYNC_READ,
          .fd = sync_file_fd,
       };
-      int ioctl_ret = drmIoctl(fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &import);
-      if (ioctl_ret) {
-         if (errno == ENOTTY || errno == EBADF || errno == ENOSYS) {
-            assert(!"how did this fail?");
-         } else {
-            ret = true;
-         }
-      }
+      ret = drmIoctl(fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &import) == 0;
       close(fd);
    }
    close(sync_file_fd);
    return ret;
 #else
-   return true;
+   return false;
 #endif
 }
 
