+static void encoder_set_parameter(Session *s, const char *key, int32_t value)
+{
+    AMediaFormat *params = AMediaFormat_new();
+    if (!params)
+        return;
+    AMediaFormat_setInt32(params, key, value);
+    media_status_t st = AMediaCodec_setParameters(s->codec, params);
+    AMediaFormat_delete(params);
+    if (st != AMEDIA_OK)
+        dlog(0, "[%d] encoder rejected %s=%d: %d", s->id, key, value, st);
+}
+
+static void encoder_request_sync(Session *s)
+{
+    dlog(2, "[%d] sync frame requested at unit %ld", s->id, s->units_in);
+    encoder_set_parameter(s, "request-sync", 0);
+}
+
+static void encoder_set_bitrate(Session *s, uint32_t bitrate)
+{
+    if (!bitrate || bitrate > 100000000u || bitrate == s->bitrate)
+        return;
+    dlog(1, "[%d] encoder bitrate %u -> %u", s->id, s->bitrate, bitrate);
+    s->bitrate = bitrate;
+    encoder_set_parameter(s, "video-bitrate", (int32_t)bitrate);
+}
+
+/* Android's own software codecs; a VA-API client expects hardware and has
+ * faster software encoders of its own. */
+static bool software_codec_name(const char *name)
+{
+    return !strncmp(name, "OMX.google.", 11) || !strncmp(name, "c2.android.", 11);
+}
+
+/* Write "<mime> <component>" for each hardware encoder to <socket>.encoders,
+ * so the VA driver advertises only those.  Replaced atomically. */
+static void write_encoder_list(const char *sock_path)
+{
+    static const char *const mimes[] = { "video/avc", "video/hevc", "video/x-vnd.on2.vp9" };
+    char path[600], next[620];
+    snprintf(path, sizeof(path), "%s.encoders", sock_path);
+    snprintf(next, sizeof(next), "%s.next", path);
+    FILE *f = fopen(next, "we");
+    if (!f) {
+        dlog(0, "cannot write %s: %s", next, strerror(errno));
+        return;
+    }
+    for (size_t i = 0; i < sizeof(mimes) / sizeof(mimes[0]); i++) {
+        AMediaCodec *codec = AMediaCodec_createEncoderByType(mimes[i]);
+        char *name = NULL;
+        if (codec && AMediaCodec_getName(codec, &name) == AMEDIA_OK && name) {
+            dlog(1, "%s encoder: %s%s", mimes[i], name,
+                 software_codec_name(name) ? " (software, not offered)" : "");
+            if (!software_codec_name(name))
+                fprintf(f, "%s %s\n", mimes[i], name);
+            AMediaCodec_releaseName(codec, name);
+        }
+        if (codec)
+            AMediaCodec_delete(codec);
+    }
+    if (fclose(f) != 0 || rename(next, path) != 0)
+        dlog(0, "cannot publish %s: %s", path, strerror(errno));
+}
