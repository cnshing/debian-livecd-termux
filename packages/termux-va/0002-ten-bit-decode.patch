+ * negotiated format.  Only Qualcomm hardware components are tried; nothing
+ * is inferred for other vendors.  TERMUX_VA_TENBIT=0 skips the probe.
+ */
+/* Generated with libx265 Main 10 and libvpx-vp9 profile 2, 96x96, one grey key frame each. */
